{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "pretest": "npm run mime-data:check",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "svg-data": "node scripts/build-svg-data.mjs",
    "mime-data": "cd .. && cargo run --quiet -p generate-mime-map -- frontend/src/generated/mimeTypes.js",
    "mime-data:check": "cd .. && cargo run --quiet -p generate-mime-map -- --check frontend/src/generated/mimeTypes.js"
  },
  "dependencies": {
    "emmet-monaco-es": "^5.7.0",
    "http-status-codes": "^2.3.0",
    "monaco-editor": "^0.57.0",
    "monaco-editor-ex": "^1.6.0",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vscode/web-custom-data": "^0.6.3",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte-check": "^4.3.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "minimatch": "11.0.5"
  }
}
